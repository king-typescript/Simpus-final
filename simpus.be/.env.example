# RustFS (S3‑compatible) – S3Mock
RUSTFS_ENDPOINT=http://rustfs:9090
RUSTFS_PUBLIC_ENDPOINT=http://localhost:9090
RUSTFS_BUCKET=bookcovers
RUSTFS_REGION=us-east-1
RUSTFS_ACCESS_KEY=rustfsadmin
RUSTFS_SECRET_KEY=rustfsadminsecret12345
# Presigned URL TTL (detik, max 3600)
RUSTFS_PRESIGNED_URL_TTL=900
