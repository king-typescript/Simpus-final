# Application Settings
NODE_ENV=production
PORT=3000
HOSTNAME=0.0.0.0

# Cookie Security
# Set ke "true" untuk produksi HTTPS, "false" untuk development IP lokal
COOKIE_SECURE=true

# URL Frontend (untuk whitelist CORS origin)
# Contoh: https://simpus.sekolah.sch.id
FRONTEND_URL=http://localhost:5173

# Database Settings (Local / Docker)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=simpus_db

# Database Connection URL
# Untuk Docker Compose internal: postgresql://postgres:postgres@postgres:5432/simpus_db?schema=public
# Untuk koneksi langsung dari host: postgresql://postgres:postgres@localhost:5432/simpus_db?schema=public
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/simpus_db?schema=public

# Authentication (Wajib minimal 32 karakter, RAHASIA — jangan share ke siapapun)
# Generate nilai acak aman dengan perintah berikut sebelum deploy:
#   Linux/macOS : openssl rand -base64 32
#   Node.js     : node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=GANTI_DENGAN_STRING_ACAK_MINIMAL_32_KARAKTER

# Migration
RUN_MIGRATION=true

# Database Seeder Credentials (Wajib minimal 12 karakter saat menjalankan seed)
SEED_ADMIN_PASSWORD=adminSimpus123
SEED_STUDENT_PASSWORD=siswaSimpus123
